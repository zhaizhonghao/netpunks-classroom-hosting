# Hosting needs only read access to the existing Sepolia deployment.
# Never add SEPOLIA_PRIVATE_KEY or PINATA_JWT to the hosting service.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
HOST=0.0.0.0
PORT=3002
RPC_LOG_BLOCK_RANGE=2000
# Optional: HTTPS origin when the hosting platform does not provide RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=
# Optional: absolute path on a persistent disk for the reconstructible SQLite index.
# SEPOLIA_DATA_DIR=/var/data/netpunks
