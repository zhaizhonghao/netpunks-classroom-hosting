        <mxCell id="valid" value="挂单、价格与买家有效？" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;rhombus;fillColor=#fff6df;strokeColor=#b99b57;spacing=10;fontSize=19;" vertex="1" parent="1">
          <mxGeometry x="690" y="690" width="300" height="120" as="geometry" />
