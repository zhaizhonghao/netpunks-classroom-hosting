        </mxCell>
        <mxCell id="view" value="用户 · 打开已上架 NFT 详情&lt;br&gt;核对售价与指定买家限制" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;rounded=1;arcSize=18;fillColor=#edf4fc;strokeColor=#6c8ebf;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="260" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="send" value="提交并确认 buy(id, expectedPrice)&lt;br&gt;携带页面确认的精确售价（见图 03）" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;shape=mxgraph.sysml.callBehAct;align=center;fillColor=#edf4fc;strokeColor=#6c8ebf;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="420" width="380" height="100" as="geometry" />
