        <mxCell id="failure" value="挂单失效、价格变化或买家不符&lt;br&gt;拒绝交易，刷新后重新确认" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;rounded=1;arcSize=18;fillColor=#fbeeee;strokeColor=#b87676;spacing=12;" vertex="1" parent="1">
