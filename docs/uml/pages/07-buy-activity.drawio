  <diagram id="07-buy-activity" name="07  按挂单价购买 NFT">
    <mxGraphModel dx="1740" dy="1580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1580" math="0" shadow="0" background="#ffffff">
      <root>
