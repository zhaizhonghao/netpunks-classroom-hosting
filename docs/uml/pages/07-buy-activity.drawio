        <mxCell id="buy-rules" value="执行时校验&lt;br&gt;&lt;br&gt;挂单仍有效，市场仍获转移授权。&lt;br&gt;预期价格与挂单现价一致。&lt;br&gt;支付的 ETH 与挂单价格一致。&lt;br&gt;买家不是卖家。&lt;br&gt;指定买家地址匹配（若设置）。&lt;br&gt;&lt;br&gt;若买家本身是最高出价者，购买时&lt;br&gt;仍支付完整售价；旧出价另计待提现。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="70" y="350" width="370" height="470" as="geometry" />
        </mxCell>
        <mxCell id="atomic" value="原子结算&lt;br&gt;&lt;br&gt;结算、退款记账与 NFT 转移处于&lt;br&gt;同一笔交易；任何一步失败全部回滚。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="70" y="980" width="370" height="200" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="● 初始节点    ◉ 活动终止    圆角框：动作    菱形：判断／合并    [ ]：分支条件    带耙形标记的框：调用子活动" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#627489;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1485" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="convention" value="蓝：操作   黄：判断   绿：成功结果   红：失败处理；“交易确认”均遵循图 03，链上校验以交易执行时状态为准。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#627489;spacing=0;" vertex="1" parent="1">
