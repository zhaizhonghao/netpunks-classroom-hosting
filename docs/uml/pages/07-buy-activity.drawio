        <mxCell id="settle" value="市场合约 · 删除挂单和现有出价&lt;br&gt;卖家收入计入待提现余额" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;rounded=1;arcSize=18;fillColor=#eaf5ef;strokeColor=#6b9a81;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="910" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="refund" value="市场合约 · 若有最高出价&lt;br&gt;将全额出价退回原出价者待提现余额" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;rounded=1;arcSize=18;fillColor=#eaf5ef;strokeColor=#6b9a81;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="1070" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="transfer" value="NFT 安全转给买家；前端刷新&lt;br&gt;卖家／原出价者按需另行提现（图 10）" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;rounded=1;arcSize=18;fillColor=#eaf5ef;strokeColor=#6b9a81;spacing=12;" vertex="1" parent="1">
