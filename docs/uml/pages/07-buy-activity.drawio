        </mxCell>
        <mxCell id="subtitle" value="活动图 · 前置条件：钱包已连接；买家不是当前卖家；若为指定买家挂单，钱包地址必须匹配。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=0;fontColor=#627489;spacing=0;" vertex="1" parent="1">
