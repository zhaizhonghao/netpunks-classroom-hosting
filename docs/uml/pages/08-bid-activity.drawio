        <mxCell id="bid-rules" value="补价与退款&lt;br&gt;&lt;br&gt;即使提高自己的出价，也需支付&lt;br&gt;新出价全额 ETH。旧金额先计入&lt;br&gt;自己的待提现余额，不自动抵扣。&lt;br&gt;&lt;br&gt;撤回仅限执行时的最高出价者；&lt;br&gt;已被替代的出价已转为待提现款。&lt;br&gt;&lt;br&gt;撤回出价 ≠ 转 ETH 到钱包。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1220" y="990" width="410" height="390" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="● 初始节点    ◉ 活动终止    圆角框：动作    菱形：判断／合并    [ ]：分支条件    带耙形标记的框：调用子活动" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#627489;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1545" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="convention" value="蓝：操作   黄：判断   绿：成功结果   红：失败处理；“交易确认”均遵循图 03，链上校验以交易执行时状态为准。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#627489;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1579" width="1600" height="26" as="geometry" />
        </mxCell>
