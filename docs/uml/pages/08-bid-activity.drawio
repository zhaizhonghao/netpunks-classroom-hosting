        <mxCell id="bid" value="用户 · 输入高于当前出价的金额&lt;br&gt;提交并确认 placeBid(id)，全额付 ETH" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;shape=mxgraph.sysml.callBehAct;align=center;fillColor=#edf4fc;strokeColor=#6c8ebf;spacing=12;" vertex="1" parent="1">
