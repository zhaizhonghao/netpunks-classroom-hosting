        <mxCell id="mint-checks" value="mintOpen 为 true；数量为 1–5&lt;br&gt;地址累计铸造量 + 数量 ≤ 5&lt;br&gt;总铸造量 + 数量 ≤ 10,000&lt;br&gt;msg.value = 当前单价 × 数量" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=16;fontColor=#162b42;fillColor=#edf4fc;strokeColor=#6c8ebf;strokeWidth=1.4;spacing=10;" vertex="1" parent="mint-panel">
