        </mxCell>
        <mxCell id="market-legend" value="每枚 NFT 只保留一个最高有效出价；出价以 ETH 全额托管，不设自动结束时间。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=0;fontColor=#627489;spacing=0;" vertex="1" parent="1">
