        <mxCell id="edge-refresh-done" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=PingFang SC;fontSize=17;strokeWidth=1.6;strokeColor=#486a90;fontColor=#162b42;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="refresh" target="done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-done-end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=PingFang SC;fontSize=17;strokeWidth=1.6;strokeColor=#486a90;fontColor=#162b42;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="done" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="public-note" value="公开查询与偏好&lt;br&gt;&lt;br&gt;浏览接口返回已铸造资产及其状态。&lt;br&gt;&lt;br&gt;简体中文／English 即时切换。&lt;br&gt;收藏、主题与语言写入 localStorage。&lt;br&gt;&lt;br&gt;个人资产、我的挂单与我的出价，&lt;br&gt;连接钱包后按当前地址查询。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="370" height="380" as="geometry" />
        </mxCell>
        <mxCell id="tx-note" value="所有链上流程的共同约定&lt;br&gt;&lt;br&gt;钱包可能拒绝确认；网络或余额可能&lt;br&gt;不满足要求，合约也可能拒绝执行。&lt;br&gt;&lt;br&gt;回滚的交易不改变该笔交易的业务&lt;br&gt;状态；链上失败仍可能消耗 Gas。&lt;br&gt;&lt;br&gt;若先授权再执行业务，授权是独立&lt;br&gt;交易，后续失败不会撤销已完成授权。&lt;br&gt;&lt;br&gt;交易已确认但刷新失败时，先刷新&lt;br&gt;状态核实结果，再决定是否重试。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="70" y="760" width="370" height="510" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="● 初始节点    ◉ 活动终止    圆角框：动作    菱形：判断／合并    [ ]：分支条件    带耙形标记的框：调用子活动" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#627489;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1565" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="convention" value="蓝：操作   黄：判断   绿：成功结果   红：失败处理；“交易确认”均遵循图 03，链上校验以交易执行时状态为准。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#627489;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1599" width="1600" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
