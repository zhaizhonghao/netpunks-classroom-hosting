        <mxCell id="mint-entry" value="mint(quantity) · payable · nonReentrant" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=14;fontColor=#162b42;fillColor=#edf4fc;strokeColor=#6c8ebf;strokeWidth=1.4;spacing=10;" vertex="1" parent="mint-panel">
