        <mxCell id="admin-scope" value="管理边界与失败情况&lt;br&gt;&lt;br&gt;系列总量上限固定 10,000 枚。&lt;br&gt;每地址累计铸造上限固定 5 枚。&lt;br&gt;&lt;br&gt;发行收入与市场待提现款分开管理。&lt;br&gt;管理入口只能提取铸造收入。&lt;br&gt;&lt;br&gt;收入不足或收款失败会拒绝／回滚；&lt;br&gt;收款失败不会丢失待提发行收入。&lt;br&gt;&lt;br&gt;钱包拒绝、链上失败及刷新异常&lt;br&gt;遵循图 03 的处理约定。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="70" y="800" width="370" height="490" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="● 初始节点    ◉ 活动终止    圆角框：动作    菱形：判断／合并    [ ]：分支条件    带耙形标记的框：调用子活动" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#627489;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1565" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="convention" value="蓝：操作   黄：判断   绿：成功结果   红：失败处理；“交易确认”均遵循图 03，链上校验以交易执行时状态为准。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=20;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#627489;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1599" width="1600" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="13-netpunks-contract-flow" name="13  NetPunks 智能合约流程图">
    <mxGraphModel page="1" pageScale="1" pageWidth="1740" pageHeight="2220" grid="1" gridSize="10" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="13  NetPunks 智能合约流程图" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=30;fontColor=#486078;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1640" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="按函数分区：每个分区表示独立调用，编号不代表执行顺序；判断、状态更新和回滚均依据当前合约源码。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#486078;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="1640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="deployment" value="constructor(base)：owner = 部署者；总量上限 10,000，每地址累计上限 5；默认单价 0.005 ETH，开放铸造，并保存基础 URI。" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;fontColor=#162b42;fillColor=#edf4fc;strokeColor=#6c8ebf;strokeWidth=1.4;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="155" width="1640" height="100" as="geometry" />
        </mxCell>
        <mxCell id="mint-panel" value="" style="rounded=1;arcSize=4;container=1;pointerEvents=0;html=1;fillColor=#ffffff;strokeColor=#c5d1df;" vertex="1" parent="1">
          <mxGeometry x="50" y="290" width="540" height="890" as="geometry" />
