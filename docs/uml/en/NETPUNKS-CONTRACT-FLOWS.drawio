        <mxCell id="atomicity" value="Any failing step reverts state, transfers and logs in that transaction. A prior approval in a separate transaction remains. Source: contracts/; 2026-10-20." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#486078;fontStyle=0;" vertex="1" parent="1">
