        <mxCell id="read-checks" value="These ERC-721 queries require an NFT&lt;br&gt;that already exists; otherwise they revert&lt;br&gt;The metadata base URI is set at deployment&lt;br&gt;No external base-URI setter is provided" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#162b42;fillColor=#edf4fc;strokeColor=#6c8ebf;strokeWidth=1.4;spacing=10;" vertex="1" parent="read-panel">
