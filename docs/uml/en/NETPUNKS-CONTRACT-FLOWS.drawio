          <mxGeometry x="390" y="360" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="read-effects" value="ownerOf: read the current owner&lt;br&gt;tokenURI: base URI + decimal token ID&lt;br&gt;An empty base URI yields an empty tokenURI&lt;br&gt;No ownership, quota or funds are changed" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#162b42;fillColor=#edf4fc;strokeColor=#6c8ebf;strokeWidth=1.4;spacing=10;" vertex="1" parent="read-panel">
