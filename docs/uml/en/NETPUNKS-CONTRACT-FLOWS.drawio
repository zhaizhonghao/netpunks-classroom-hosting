  <diagram id="14-market-contract-flow" name="14  NetPunksMarket contract flowchart">
    <mxGraphModel page="1" pageScale="1" pageWidth="1740" pageHeight="3140" grid="1" gridSize="10" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="14  NetPunksMarket contract flowchart" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#486078;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1640" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Each panel is an independent function flow, not a sequential or parallel stage. Checks, effects and rollback follow the current source." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#486078;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="1640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="deployment" value="constructor(collection): store the immutable NFT reference. The market has no issuance-admin privileges. NR = nonReentrant." style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#162b42;fillColor=#edf4fc;strokeColor=#6c8ebf;strokeWidth=1.4;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="155" width="1640" height="100" as="geometry" />
        </mxCell>
        <mxCell id="listing-panel" value="" style="rounded=1;arcSize=4;container=1;pointerEvents=0;html=1;fillColor=#ffffff;strokeColor=#c5d1df;" vertex="1" parent="1">
          <mxGeometry x="50" y="290" width="540" height="890" as="geometry" />
        </mxCell>
        <mxCell id="listing-title" value="01  Read a valid listing" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#486078;fontStyle=1;" vertex="1" parent="listing-panel">
          <mxGeometry x="20" y="15" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="listing-entry" value="getListing(id) · view" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#162b42;fillColor=#edf4fc;strokeColor=#6c8ebf;strokeWidth=1.4;spacing=10;" vertex="1" parent="listing-panel">
          <mxGeometry x="25" y="75" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="listing-checks" value="A seller is recorded and still owns the NFT&lt;br&gt;Ownership version matches the snapshot&lt;br&gt;Token-approval version matches&lt;br&gt;Operator-approval version matches&lt;br&gt;Market still has transfer approval" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#162b42;fillColor=#edf4fc;strokeColor=#6c8ebf;strokeWidth=1.4;spacing=10;" vertex="1" parent="listing-panel">
          <mxGeometry x="25" y="175" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="listing-valid" value="Checks pass?" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#162b42;fillColor=#fff6df;strokeColor=#b99b57;strokeWidth=1.4;spacing=10;" vertex="1" parent="listing-panel">
          <mxGeometry x="50" y="355" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="listing-failure" value="Return empty listing&lt;br&gt;No storage change" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#162b42;fillColor=#eaf5ef;strokeColor=#6b9a81;strokeWidth=1.4;spacing=10;" vertex="1" parent="listing-panel">
          <mxGeometry x="390" y="360" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="listing-effects" value="Return stored seller / price / onlyBuyer&lt;br&gt;and the three version snapshots&lt;br&gt;This query does not delete stale listings" style="rounded=1;arcSize=14;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#162b42;fillColor=#edf4fc;strokeColor=#6c8ebf;strokeWidth=1.4;spacing=10;" vertex="1" parent="listing-panel">
