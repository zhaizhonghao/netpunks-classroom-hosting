        <mxCell id="listing-rules" value="Listing Validity&lt;br&gt;&lt;br&gt;A purchase rechecks seller ownership, approval, and recorded version snapshots.&lt;br&gt;&lt;br&gt;A transfer invalidates the old listing. Transferring away and back does not restore it.&lt;br&gt;&lt;br&gt;Approval changes can invalidate a listing. Reapproval alone does not restore it; list again." style="html=1;whiteSpace=wrap;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="1220" y="970" width="410" height="420" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="● Initial  |  ◉ Activity final  |  Rounded box: action  |  Diamond: decision / merge  |  [ ]: guard  |  Rake marker: call behavior action" style="html=1;whiteSpace=wrap;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=0;fontColor=#627489;spacing=0;fontFamily=Arial;fontSize=16;" vertex="1" parent="1">
