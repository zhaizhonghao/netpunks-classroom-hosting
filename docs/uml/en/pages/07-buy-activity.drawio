        <mxCell id="buy-rules" value="Execution-Time Checks&lt;br&gt;&lt;br&gt;Listing is valid; market still approved.&lt;br&gt;Expected price = current listed price.&lt;br&gt;ETH paid = current listed price.&lt;br&gt;Buyer is not the seller.&lt;br&gt;Buyer matches any private restriction.&lt;br&gt;&lt;br&gt;A buyer who is also the highest bidder still pays the full purchase price. The old bid becomes pending funds." style="html=1;whiteSpace=wrap;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="70" y="350" width="370" height="470" as="geometry" />
        </mxCell>
        <mxCell id="atomic" value="Atomic Settlement&lt;br&gt;&lt;br&gt;Settlement, refund accounting, and NFT transfer share one transaction. Any failure reverts all of it." style="html=1;whiteSpace=wrap;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="70" y="980" width="370" height="200" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="● Initial  |  ◉ Activity final  |  Rounded box: action  |  Diamond: decision / merge  |  [ ]: guard  |  Rake marker: call behavior action" style="html=1;whiteSpace=wrap;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=0;fontColor=#627489;spacing=0;fontFamily=Arial;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="1485" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="convention" value="Blue: action  |  Yellow: decision  |  Green: result  |  Red: failure. Confirm transactions as in Diagram 03; checks use execution-time state." style="html=1;whiteSpace=wrap;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=0;fontColor=#627489;spacing=0;fontFamily=Arial;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="1519" width="1600" height="26" as="geometry" />
