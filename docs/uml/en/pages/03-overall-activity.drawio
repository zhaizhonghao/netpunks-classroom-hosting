        <mxCell id="public-note" value="Public Queries and Preferences&lt;br&gt;&lt;br&gt;The browsing API returns minted assets and their state.&lt;br&gt;&lt;br&gt;Switch instantly between Simplified Chinese and English. Favorites, theme, and language use localStorage.&lt;br&gt;&lt;br&gt;After connection, query assets, listings, and bids for the current wallet." style="html=1;whiteSpace=wrap;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="370" height="380" as="geometry" />
        </mxCell>
        <mxCell id="tx-note" value="Shared Transaction Rules&lt;br&gt;&lt;br&gt;The wallet may reject confirmation. Chain, balance, or contract checks may prevent execution.&lt;br&gt;&lt;br&gt;A reverted transaction leaves its business state unchanged; an on-chain failure may still cost gas.&lt;br&gt;&lt;br&gt;Approval is a separate transaction. A later failure does not undo an approval that succeeded.&lt;br&gt;&lt;br&gt;If confirmation succeeds but refresh fails, reload and verify the state before retrying." style="html=1;whiteSpace=wrap;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="70" y="760" width="370" height="510" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="● Initial  |  ◉ Activity final  |  Rounded box: action  |  Diamond: decision / merge  |  [ ]: guard  |  Rake marker: call behavior action" style="html=1;whiteSpace=wrap;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=0;fontColor=#627489;spacing=0;fontFamily=Arial;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="70" y="1565" width="1600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="convention" value="Blue: action  |  Yellow: decision  |  Green: result  |  Red: failure. Confirm transactions as in Diagram 03; checks use execution-time state." style="html=1;whiteSpace=wrap;fontColor=#162b42;strokeWidth=1.6;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=0;fontColor=#627489;spacing=0;fontFamily=Arial;fontSize=16;" vertex="1" parent="1">
