        <mxCell id="mint-rules" value="Mint Validation&lt;br&gt;&lt;br&gt;Minting must be open.&lt;br&gt;Quantity: 1–5 NFTs.&lt;br&gt;Lifetime wallet count + quantity ≤ 5.&lt;br&gt;Total minted + quantity ≤ 10,000.&lt;br&gt;Payment = execution-time price × quantity.&lt;br&gt;&lt;br&gt;Transferring NFTs does not restore the mint allowance.&lt;br&gt;An invalid NFT receiver also causes a revert." style="html=1;whiteSpace=wrap;fontColor=#162b42;strokeWidth=1.6;shape=note;size=18;backgroundOutline=1;fillColor=#f6f8fb;strokeColor=#c5d1df;align=left;verticalAlign=top;spacing=20;fontFamily=Arial;fontSize=17;" vertex="1" parent="1">
